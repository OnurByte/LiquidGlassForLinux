{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liquid-glass-icon.dev/schema/icon-manifest.schema.json",
  "title": "Liquid Glass canonical SVG manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "canvas", "svg", "layers", "document", "generator"],
  "properties": {
    "schema_version": { "const": 4 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "color_space", "has_alpha"],
      "properties": {
        "width": { "const": 1024 },
        "height": { "const": 1024 },
        "color_space": { "const": "sRGB" },
        "has_alpha": { "const": true }
      }
    },
    "svg": { "const": "icon.svg" },
    "layers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 17,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "z_index"],
          "properties": { "id": { "const": "background" }, "z_index": { "const": 0 } }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "z_index"],
        "properties": {
          "id": { "pattern": "^(foreground-[1-4]|layer-[1-4]-[1-4])$" },
          "z_index": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "groups"],
      "properties": {
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "z_index"],
          "properties": { "id": { "const": "background" }, "z_index": { "const": 0 } }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "z_index", "layers", "material", "dark", "mono"],
            "properties": {
              "id": { "pattern": "^(foreground-[1-4]|group-[1-4])$" },
              "z_index": { "type": "integer", "minimum": 1, "maximum": 4 },
              "layers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "z_index"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "z_index": { "type": "integer", "minimum": 1, "maximum": 4 }
                  }
                }
              },
              "material": {
                "type": "object",
                "additionalProperties": false,
                "required": ["effects_enabled", "mode", "specular", "blur", "refraction", "translucency", "shadow"],
                "properties": {
                  "effects_enabled": { "type": "boolean" },
                  "mode": { "enum": ["individual", "combined"] },
                  "specular": { "enum": ["off", "automatic", "inside", "outside"] },
                  "blur": { "type": "number", "minimum": 0, "maximum": 1 },
                  "refraction": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "translucency": { "type": "number", "minimum": 0, "maximum": 1 },
                  "shadow": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              "dark": { "$ref": "#/$defs/appearanceAnnotation" },
              "mono": { "$ref": "#/$defs/appearanceAnnotation" }
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "prompt_version"],
      "properties": {
        "provider": { "enum": ["codex-exec", "responses-api"] },
        "model": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "integer", "minimum": 3 }
      }
    }
  },
  "$defs": {
    "appearanceAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opacity", "effects_enabled"],
      "properties": {
        "opacity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "effects_enabled": { "type": ["boolean", "null"] }
      }
    }
  }
}
